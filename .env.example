# TMDB API 配置
# 前往 https://www.themoviedb.org/settings/api 获取

# 读访问令牌（Bearer Token）— 用于 Authorization 头
TMDB_API_READ_TOKEN=your_read_access_token_here

# API 密钥（v3 auth）— 备用
TMDB_API_KEY=your_api_key_here

# HTTP 代理（中国大陆访问 TMDB 需要）
# 示例: http://127.0.0.1:7890
# TMDB_HTTP_PROXY=http://127.0.0.1:7890
